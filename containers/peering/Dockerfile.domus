FROM rust:1-bookworm AS builder
WORKDIR /workspace
COPY . .
RUN cargo build --release --manifest-path testing/peering/apps/peering-domus/Cargo.toml

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libcap2-bin \
        iproute2 \
        iputils-ping \
    && setcap cap_net_admin+ep /sbin/tc \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin appuser

COPY --from=builder /workspace/testing/peering/apps/peering-domus/target/release/peering-domus /usr/local/bin/peering-domus
USER appuser
EXPOSE 5001
ENTRYPOINT ["peering-domus"]
