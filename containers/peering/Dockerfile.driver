ARG AURELIA_E2E_BUILDER_BASE=aurelia-e2e-builder-base:local
ARG AURELIA_E2E_RUNTIME_BASE=aurelia-e2e-runtime-base:local

FROM ${AURELIA_E2E_BUILDER_BASE} AS builder
COPY --chown=appuser:appuser Cargo.toml Cargo.lock ./
COPY --chown=appuser:appuser src ./src
COPY --chown=appuser:appuser testing/peering/apps/peering-driver ./testing/peering/apps/peering-driver
RUN cargo build --release --manifest-path testing/peering/apps/peering-driver/Cargo.toml

FROM ${AURELIA_E2E_RUNTIME_BASE}
COPY --from=builder /workspace/testing/peering/apps/peering-driver/target/release/peering-driver /usr/local/bin/peering-driver
USER appuser
ENTRYPOINT ["peering-driver"]
